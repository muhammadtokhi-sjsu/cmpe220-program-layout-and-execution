_start:
    movl r0, #5
    movh r0, #0
    bl fact
    bl print_num

    movl r0, #0x0A
    movl r1, #0x02
    movh r1, #0x80
    str r0, r1
    halt

fact:
    push rbl
    movl r1, #1
    movh r1, #0
    cmp r0, r1
    ble fact_base

    push r0
    sub r0, r0, r1
    bl fact

    pop r1
    mul r0, r1, r0
    ret

fact_base:
    movl r0, #1
    movh r0, #0
    ret

print_num:
    push rbl
    movl r1, #10
    movh r1, #0
    div r2, r0, r1
    mul r3, r2, r1
    sub r3, r0, r3
    push r3

    movl r1, #0
    cmp r2, r1
    ble print_digit

    mov r0, r2
    bl print_num

print_digit:
    pop r0
    movl r1, #0x30
    movh r1, #0
    add r0, r0, r1
    movl r1, #0x02
    movh r1, #0x80
    str r0, r1
    ret